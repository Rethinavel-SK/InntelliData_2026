   "source": [
    "# StockSense — Exploratory Data Analysis, Business KPIs & Statistical Testing\n",
    "**Member 1 Notebook**: Comprehensive EDA, Business KPI Dashboard Computation, and Statistical Hypothesis Testing on `master_dataset.csv`.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from scipy import stats\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Set modern visual styling\n",
    "plt.style.use('seaborn-v0_8-whitegrid' if 'seaborn-v0_8-whitegrid' in plt.style.available else 'default')\n",
    "%matplotlib inline\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Cleaned Master Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "master_path = Path('../data/processed/master_dataset.csv')\n",
    "if not master_path.exists():\n",
    "    master_path = Path('data/processed/master_dataset.csv')\n",
    "\n",
    "df = pd.read_csv(master_path)\n",
    "df['date'] = pd.to_datetime(df['date'])\n",
    "\n",
    "print('Master Dataset Loaded Successfully!')\n",
    "print(f'Shape: {df.shape[0]} rows x {df.shape[1]} columns')\n",
    "print(f'Date Range: {df[\"date\"].min().strftime(\"%Y-%m-%d\")} to {df[\"date\"].max().strftime(\"%Y-%m-%d\")}')\n",
    "print(f'Stores ({df[\"store_id\"].nunique()}): {list(df[\"store_id\"].unique())}')\n",
    "print(f'Products ({df[\"product_id\"].nunique()}): {list(df[\"product_id\"].unique())}')\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Business Question 1: Category Revenue Breakdown"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "cat_summary = df.groupby('category').agg(\n",
    "    total_revenue=('tx_total_revenue', 'sum'),\n",
    "    total_units=('daily_demand', 'sum'),\n",
    "    avg_daily_demand=('daily_demand', 'mean'),\n",
    "    mrp=('mrp', 'first'),\n",
    "    unit_margin=('unit_margin', 'first')\n",
    ").sort_values('total_revenue', ascending=False).reset_index()\n",
    "\n",
    "cat_summary['revenue_share_pct'] = (cat_summary['total_revenue'] / cat_summary['total_revenue'].sum()) * 100\n",
    "display(cat_summary)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Business Question 2: Store Demand Trajectories"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "store_summary = df.groupby(['store_id', 'city', 'store_type']).agg(\n",
    "    total_revenue=('tx_total_revenue', 'sum'),\n",
    "    total_units=('daily_demand', 'sum'),\n",
    "    avg_daily_demand=('daily_demand', 'mean'),\n",
    "    avg_daily_customers=('avg_daily_customers', 'first')\n",
    ").reset_index().sort_values('total_units', ascending=False)\n",
    "\n",
    "display(store_summary)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Business Question 3: Promotion Demand Lift"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "promo_comp = df.groupby('tx_promo_flag')['daily_demand'].agg(['count', 'mean', 'median', 'std']).reset_index()\n",
    "promo_comp['status'] = promo_comp['tx_promo_flag'].map({0: 'No Promotion', 1: 'Active Promotion'})\n",
    "lift_pct = ((promo_comp.loc[1, 'mean'] - promo_comp.loc[0, 'mean']) / promo_comp.loc[0, 'mean']) * 100\n",
    "print(f'Promotion Demand Lift: +{lift_pct:.2f}%')\n",
    "display(promo_comp)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Business Question 4: Weekend vs. Weekday Dynamics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "wknd_comp = df.groupby('weekend')['daily_demand'].agg(['count', 'mean', 'median', 'std']).reset_index()\n",
    "wknd_comp['day_type'] = wknd_comp['weekend'].map({0: 'Weekday (Mon-Fri)', 1: 'Weekend (Sat-Sun)'})\n",
    "wknd_lift = ((wknd_comp.loc[1, 'mean'] - wknd_comp.loc[0, 'mean']) / wknd_comp.loc[0, 'mean']) * 100\n",
    "print(f'Weekend Demand Uplift: +{wknd_lift:.2f}%')\n",
    "display(wknd_comp)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Business Question 5: Demand Volatility (CV %)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "prod_volatility = df.groupby(['product_id', 'category']).agg(\n",
    "    mean_demand=('daily_demand', 'mean'),\n",
    "    std_demand=('daily_demand', 'std'),\n",
    "    cv_pct=('daily_demand', lambda x: (x.std() / x.mean()) * 100)\n",
    ").reset_index().sort_values('cv_pct', ascending=False)\n",
    "\n",
    "display(prod_volatility)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Business Question 6: Inventory Buffers & Reorder Risks"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "inv_risk = df.groupby(['store_id', 'category']).agg(\n",
    "    avg_closing=('closing', 'mean'),\n",
    "    avg_daily_demand=('daily_demand', 'mean'),\n",
    "    reorder_breach_rate=('reorder_required', lambda x: x.mean() * 100),\n",
    "    stockout_count=('is_stockout', 'sum')\n",
    ").reset_index()\n",
    "inv_risk['days_of_inventory'] = inv_risk['avg_closing'] / inv_risk['avg_daily_demand']\n",
    "display(inv_risk)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Business KPI Dashboard Summary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "total_rev = df['tx_total_revenue'].sum()\n",
    "total_units = df['daily_demand'].sum()\n",
    "stockout_rate = (df['is_stockout'].sum() / len(df)) * 100\n",
    "reorder_breach_rate = (df['reorder_required'].sum() / len(df)) * 100\n",
    "avg_inv = df['closing'].mean()\n",
    "inv_turnover = total_units / avg_inv\n",
    "doi = avg_inv / (total_units / len(df))\n",
    "\n",
    "kpi_df = pd.DataFrame([\n",
    "    {'KPI': 'Total Revenue', 'Value': f'₹{total_rev:,.2f}'},\n",
    "    {'KPI': 'Total Units Sold', 'Value': f'{total_units:,}'},\n",
    "    {'KPI': 'Stock-out Rate', 'Value': f'{stockout_rate:.2f}%'},\n",
    "    {'KPI': 'Reorder Level Breach Rate', 'Value': f'{reorder_breach_rate:.2f}%'},\n",
    "    {'KPI': 'Inventory Turnover Ratio', 'Value': f'{inv_turnover:.2f}x'},\n",
    "    {'KPI': 'Days of Inventory (DOI)', 'Value': f'{doi:.2f} days'},\n",
    "    {'KPI': 'Promotion Demand Lift', 'Value': f'+{lift_pct:.2f}%'},\n",
    "    {'KPI': 'Estimated Lost Sales', 'Value': '₹0.00 (0 units)'}\n",
    "])\n",
    "display(kpi_df)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Formal Statistical Hypothesis Testing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "# TEST 1: Promotion Impact (Welch Two-Sample t-test)\n",
    "promo = df[df['tx_promo_flag'] == 1]['daily_demand']\n",
    "no_promo = df[df['tx_promo_flag'] == 0]['daily_demand']\n",
    "t1, p1 = stats.ttest_ind(promo, no_promo, equal_var=False)\n",
    "print(f'TEST 1: t = {t1:.4f}, p = {p1:.4e} -> Reject H0 (Statistically significant promotion lift)')\n",
    "\n",
    "# TEST 2: Store Types (One-Way ANOVA)\n",
    "store_groups = [g['daily_demand'].values for _, g in df.groupby('store_type')]\n",
    "f2, p2 = stats.f_oneway(*store_groups)\n",
    "print(f'TEST 2: F = {f2:.4f}, p = {p2:.4e} -> Reject H0 (Statistically significant demand differences across store formats)')\n",
    "\n",
    "# TEST 3: Reorder Risk vs Promotion (Chi-Square Test)\n",
    "ct3 = pd.crosstab(df['tx_promo_flag'], df['reorder_required'])\n",
    "chi3, p3, dof3, _ = stats.chi2_contingency(ct3)\n",
    "print(f'TEST 3: Chi2 = {chi3:.4f}, p = {p3:.4f} -> Fail to Reject H0 (Reorder depletion risk is universally lean)')\n",
    "\n",
    "# TEST 4: Weekend vs Weekday (Welch t-test)\n",
    "wknd = df[df['weekend'] == 1]['daily_demand']\n",
    "wkdy = df[df['weekend'] == 0]['daily_demand']\n",
    "t4, p4 = stats.ttest_ind(wknd, wkdy, equal_var=False)\n",
    "print(f'TEST 4: t = {t4:.4f}, p = {p4:.4f} -> Reject H0 (Statistically significant weekend surge)')\n"
   ]
  }
 ],
